//Use the params to define reference files, directories, and CLI options
params {

    // Reads and references
    reads = "/projectnb/bf528/materials/labs/lab07/samples/*_{R1,R2}.fq.gz"
    adapter_fa = "/projectnb/bf528/materials/labs/lab07/refs/TruSeq3-PE.fa"
    genome_chr16 = "/projectnb/bf528/materials/labs/lab07/refs/chr16_only.fa"
    gtf = "/projectnb/bf528/materials/labs/lab07/refs/gencode.v45.primary_assembly.annotation.gtf"

    // Directories
    outdir = "$projectDir/results/"

}

profiles {
    conda {
        conda.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.pullTimeout = "40m"
    }
    cluster {
        process {
                executor = 'sge'
                clusterOptions = '-P bf528'
                penv = 'omp'

                withLabel: process_single {
                    cpus = 1
                }

                withLabel: process_low {
                    cpus = 4

                }
                withLabel: process_medium {
                    cpus = 8
                }
                
                withLabel: process_high {
                    cpus = 16
                }
        }
    }

    local {
        process.executor = 'local'
    }
}

//Change the queueSize to enable more parallel jobs (remember the SCC is a shared resource)
executor {
    $sge {
        queueSize = 8
    }
    $local {
        cpus = 1
    }
}

//Miscellaneous CLI flags
resume = true