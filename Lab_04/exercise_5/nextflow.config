params {

    samplesheet = "$projectDir/samplesheet.csv"
    outdir = "$projectDir/results/"
    gtf = "/projectnb/bf528/materials/labs/lab04/gencode.vM34.primary_assembly.annotation.gtf"

}

profiles{
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    cluster {
        process {
            executor = 'sge'
            clusterOptions = '-P bf528'
            penv = 'omp'

            withLabel: process_medium {
                cpus = 4
            }
        }

    }
    local {
        process.executor = 'local'
    }

}

executor {
    $sge {
        queueSize = 8
    }
    $local {
        cpus = 1
    }
}

resume = true