params {

    samplesheet = "$projectDir/samplesheet.csv"

    // This is the directory where the files are located
    // You'll need to edit this before using Channel.fromFilePairs
    // See the documentation for fromFilePairs
    sample_dir = '/projectnb/bf528/materials/labs/lab04/subsampled/*_{R1,R2}.fastq.gz'

    outdir = "$projectDir/results/"


}

profiles{
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    cluster {
        process {
            executor = 'sge'
            clusterOptions = '-P bf528'
            penv = 'omp'
        }
    }
    local {
        process.executor = 'local'
    }

}

executor {
    $local {
        cpus = 1
    }
    $sge {
        queueSize = 8
    }
}

resume = true